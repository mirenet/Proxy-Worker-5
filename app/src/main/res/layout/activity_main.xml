<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070707"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header red iz HTML primera: usklađena veličina naslova i dugmadi, pomereno 5px ulevo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginTop="-5dp"
                android:fontFamily="sans-serif-medium"
                android:text="Local Host"
                android:textColor="#CBD868"
                android:textSize="20sp" />

            <!-- Kontejner za dugmad pomeren 5px ulevo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Import dugme (+) -->
                <ImageView
                    android:id="@+id/btnImport"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_action_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/bg_plus_icon" />

                <!-- Export dugme (strelica u stranu -->)
                <ImageView
                    android:id="@+id/btnExport"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_action_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/bg_arrow_icon" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="6dp"
            android:text="Enter Port"
            android:textColor="#9E9DA4"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPort"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:text="48912"
            android:textColor="#DADADA"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="6dp"
            android:text="Password"
            android:textColor="#9E9DA4"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:text="M2K938si7MwAb29shoLHew2B9hwx7N2oZwbd18"
            android:textColor="#DADADA"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="6dp"
            android:text="All Hosts"
            android:textColor="#9E9DA4"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etHosts"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_input"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:text="ws.audioscrobbler.com, www.last.fm, api.discogs.com, www.googleapis.com, www.youtube.com, m.youtube.com, api.deezer.com, wikipedia.org, en.wikipedia.org, lrclib.net, lyrics.lewagon.ai, api.lyrics.ovh"
            android:textColor="#DADADA"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTurnOn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_on_ripple"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Turn On"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTurnOff"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_off_ripple"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Turn Off"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="20dp"
            android:text="Status: OFF"
            android:textColor="#D94242"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"
            android:background="#1A1A1A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="10dp"
            android:text="Parameters"
            android:textColor="#CBD868"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="30dp"
            android:lineSpacingMultiplier="1.3"
            android:text="• URL: Enter URL\n• KEY: Password\n• API: Data/Api requests\n• HTML: Loading pages\n• WAIT: Page loading time\n• UA: Custom User-Agent"
            android:textColor="#9E9DA4"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="8dp"
            android:text="Usage Example:"
            android:textColor="#7F9CAB"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.2"
            android:text="http://127.0.0.1:8080/?key=7777\nproxy://action?start=10"
            android:textColor="#CBD868"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
