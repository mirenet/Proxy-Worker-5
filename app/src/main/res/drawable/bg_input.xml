<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Stanje kada je polje fokusirano (kliknuto) -> svetliji border (#888888) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#121212" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#888888" />
        </shape>
    </item>
    
    <!-- Podrazumevano stanje -> standardni tamni border (#606060) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#121212" />
            <corners android:radius="10dp" />
            <stroke android:width="0.8dp" android:color="#606060" />
        </shape>
    </item>
</selector>
